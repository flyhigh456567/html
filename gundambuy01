<!-- Admin modal -->
<div class="overlay" id="adminModal"><div class="modal wide"><div class="modal-head"><h2>基地管理 / ADMIN CONSOLE</h2><button class="close" data-close="adminModal">×</button></div><div class="modal-body"><div class="notice">僅限你在程式設定的管理員 Email 使用。實際權限仍必須由 Firestore / Storage Rules 強制驗證。</div><div class="tabs"><button class="tab active" data-admin-tab="edit">建立商品</button><button class="tab" data-admin-tab="list">商品管理</button></div><form id="productForm"><input type="hidden" id="editProductId"><div class="form-grid"><div class="form-group full"><label>商品名稱 *</label><input class="field" id="pName" required="" maxlength="120"></div><div class="form-group"><label>商品代碼 / SKU</label><input class="field" id="pSku" maxlength="50"></div><div class="form-group"><label>分類 *</label><select class="field" id="pCategory" required=""><option>鋼彈模型</option><option>收藏周邊</option><option>工具耗材</option><option>限定商品</option></select></div><div class="form-group"><label>售價（新台幣）*</label><input class="field" id="pPrice" type="number" min="0" step="1" required=""></div><div class="form-group"><label>庫存數量 *</label><input class="field" id="pStock" type="number" min="0" step="1" required=""></div><div class="form-group full"><label>商品描述</label><textarea class="field" id="pDescription" rows="3" maxlength="2000"></textarea></div><div class="form-group full"><label>商品圖片（可多選）</label><input class="field" id="pImages" type="file" accept="image/*" multiple=""><div class="hint">可一次上傳多張圖片；編輯商品時新增圖片會保留舊圖。請勿上傳未取得使用權的圖片。</div><div class="file-list" id="imagePreview"></div></div><div class="form-group full"><label><input id="pActive" type="checkbox" checked=""> 上架販售</label></div></div><div class="form-actions"><button class="btn btn-outline" type="button" id="resetProductForm">清空表單</button><button class="btn btn-blue" type="submit" id="saveProductBtn">儲存商品資料</button></div></form><div id="adminProducts" class="admin-list hidden"></div></div></div></div>
<div class="toast" id="toast" role="status"></div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.0/firebase-app.js";
import { getAuth, onAuthStateChanged, createUserWithEmailAndPassword, signInWithEmailAndPassword, signOut, sendPasswordResetEmail, updateProfile } from "https://www.gstatic.com/firebasejs/11.6.0/firebase-auth.js";
import { getFirestore, collection, doc, getDoc, getDocs, addDoc, setDoc, updateDoc, deleteDoc, query, where, orderBy, serverTimestamp } from "https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js";
import { getStorage, ref, uploadBytes, getDownloadURL, deleteObject } from "https://www.gstatic.com/firebasejs/11.6.0/firebase-storage.js";

/* 已填入您的 Firebase Web App 設定 */
const firebaseConfig = {
  apiKey: "AIzaSyDcHX3JY6BpqfyaVfmIpCw2cG6WaX_tWGQ",
  authDomain: "gundambuy-7a8de.firebaseapp.com",
  projectId: "gundambuy-7a8de",
  storageBucket: "gundambuy-7a8de.firebasestorage.app",
  messagingSenderId: "537771149480",
  appId: "1:537771149480:web:fecd8e082cfcc4076f5a9d"
};

/* 請將此處改成您的管理員 Email */
const ADMIN_EMAILS = ["admin@example.com"];
const CHECKOUT_ENDPOINT = ""; 

const $ = id => document.getElementById(id);
const state = { app:null, auth:null, db:null, storage:null, user:null, products:[], cart:readCart(), isAdmin:false, currentDetail:null, detailImage:0, oldImages:[], selectedFiles:[] };
function readCart(){try{return JSON.parse(localStorage.getItem("ud_cart")||"[]")}catch{return []}}
function saveCart(){localStorage.setItem("ud_cart",JSON.stringify(state.cart));renderCartCount()}
function money(n){return "NT$ "+Number(n||0).toLocaleString("zh-TW")}
function escapeHTML(v=""){return String(v).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
function toast(msg){$("toast").textContent=msg;$("toast").classList.add("show");clearTimeout(toast.timer);toast.timer=setTimeout(()=>$("toast").classList.remove("show"),3200)}
function notice(el,msg,type=""){el.className="notice"+(type?" "+type:"");el.textContent=msg}
function openModal(id){$(id).classList.add("open");document.body.style.overflow="hidden"}
function closeModal(id){$(id).classList.remove("open");if(!document.querySelector(".overlay.open"))document.body.style.overflow=""}
document.querySelectorAll("[data-close]").forEach(b=>b.addEventListener("click",()=>closeModal(b.dataset.close)));
document.querySelectorAll(".overlay").forEach(o=>o.addEventListener("click",e=>{if(e.target===o)closeModal(o.id)}));
document.addEventListener("keydown",e=>{if(e.key==="Escape")document.querySelectorAll(".overlay.open").forEach(o=>closeModal(o.id))});
function authError(e){const map={"auth/invalid-credential":"帳號或密碼錯誤。","auth/email-already-in-use":"此 Email 已註冊。","auth/weak-password":"密碼至少需要 6 個字元。","auth/invalid-email":"Email 格式不正確。","auth/too-many-requests":"嘗試次數過多，請稍後再試。","auth/network-request-failed":"網路連線失敗，請稍後再試。"};return map[e.code]||e.message||"操作失敗，請稍後再試。"}
function requireFirebase(){if(!state.db||!state.auth)throw new Error("Firebase 尚未初始化完成。")}
function renderCartCount(){$("cartCount").textContent=state.cart.reduce((n,x)=>n+x.qty,0)}
function imageFor(p){return p.images?.[0]||""}
function productCard(p){const img=imageFor(p);return `<article class="product-card"><div class="product-img" data-detail="${escapeHTML(p.id)}">${img?`<img loading="lazy" src="${escapeHTML(img)}" alt="${escapeHTML(p.name)}">`:`<div class="placeholder">UD</div>`}<span class="product-badge">${escapeHTML(p.category||"SUPPLY")}</span></div><div class="product-info"><div class="product-code">${escapeHTML(p.sku||"UD-"+String(p.id).slice(-6).toUpperCase())}</div><h3>${escapeHTML(p.name)}</h3><div class="product-desc">${escapeHTML(p.description||"基地補給商品，點擊查看詳細資訊。")}</div><div class="product-bottom"><div class="price">${money(p.price)}<small> / 件</small></div><button class="add-btn" data-add="${escapeHTML(p.id)}" aria-label="加入購物車">+</button></div></div></article>`}
function renderProducts(){const term=$("searchInput").value.trim().toLowerCase(),cat=$("categoryFilter").value,sort=$("sortFilter").value;let ps=state.products.filter(p=>p.active!==false&&(!cat||p.category===cat)&&(!term||`${p.name} ${p.sku||""} ${p.description||""}`.toLowerCase().includes(term)));if(sort==="price-asc")ps.sort((a,b)=>a.price-b.price);if(sort==="price-desc")ps.sort((a,b)=>b.price-a.price);if(sort==="name")ps.sort((a,b)=>a.name.localeCompare(b.name,"zh-Hant"));$("productGrid").innerHTML=ps.length?ps.map(productCard).join(""):`<div class="empty">目前沒有符合條件的商品。<br><br>${state.isAdmin?'請至「基地管理」建立商品。':'請調整搜尋條件，或稍後再回來查看補給。'}</div>`}
$("searchInput").addEventListener("input",renderProducts);$("categoryFilter").addEventListener("change",renderProducts);$("sortFilter").addEventListener("change",renderProducts);
document.addEventListener("click",e=>{const add=e.target.closest("[data-add]");if(add){addToCart(add.dataset.add);return}const detail=e.target.closest("[data-detail]");if(detail)showDetail(detail.dataset.detail)});
function addToCart(id){const p=state.products.find(x=>x.id===id);if(!p)return;const row=state.cart.find(x=>x.id===id);if(row)row.qty++;else state.cart.push({id,qty:1});saveCart();toast("已加入補給清單："+p.name)}
function renderCart(){const box=$("cartItems");if(!state.cart.length){box.innerHTML='<div class="empty">購物車目前是空的，去目錄選擇補給吧。</div>';$("cartTotal").textContent=money(0);return}let total=0;box.innerHTML=state.cart.map(row=>{const p=state.products.find(x=>x.id===row.id)||row.product;if(!p)return "";total+=Number(p.price)*row.qty;return `<div class="cart-row"><img class="cart-thumb" src="${escapeHTML(imageFor(p))}" alt=""><div><h4>${escapeHTML(p.name)}</h4><p>${money(p.price)} / 件</p><div class="qty"><button data-qty="${escapeHTML(row.id)}" data-delta="-1">−</button><span>${row.qty}</span><button data-qty="${escapeHTML(row.id)}" data-delta="1">+</button><button class="btn btn-outline" style="padding:4px 7px;font-size:10px" data-remove="${escapeHTML(row.id)}">移除</button></div></div><strong>${money(p.price*row.qty)}</strong></div>`}).join("");$("cartTotal").textContent=money(total)}
document.addEventListener("click",e=>{const q=e.target.closest("[data-qty]");if(q){const r=state.cart.find(x=>x.id===q.dataset.qty);if(r){r.qty+=Number(q.dataset.delta);if(r.qty<1)state.cart=state.cart.filter(x=>x.id!==r.id);saveCart();renderCart()}return}const rem=e.target.closest("[data-remove]");if(rem){state.cart=state.cart.filter(x=>x.id!==rem.dataset.remove);saveCart();renderCart()}});
$("cartBtn").addEventListener("click",()=>{renderCart();if(state.user){$("checkoutName").value=$("profileName").value||state.user.displayName||"";$("checkoutPhone").value=$("profilePhone").value||"";$("checkoutAddress").value=$("profileAddress").value||""}openModal("cartModal")});
function showDetail(id){const p=state.products.find(x=>x.id===id);if(!p)return;state.currentDetail=p;state.detailImage=0;renderDetail();openModal("detailModal")}
function renderDetail(){const p=state.currentDetail;if(!p)return;const imgs=p.images||[];const img=imgs[state.detailImage]||"";$("detailBody").innerHTML=`<div class="detail-grid"><div><img class="detail-main" src="${escapeHTML(img)}" alt="${escapeHTML(p.name)}">${imgs.length>1?`<div class="thumbs">${imgs.map((u,i)=>`<img class="${i===state.detailImage?'active':''}" data-thumb="${i}" src="${escapeHTML(u)}" alt="商品圖片 ${i+1}">`).join("")}</div>`:""}</div><div><div class="eyebrow section-tag">${escapeHTML(p.category||"SUPPLY")} / ${escapeHTML(p.sku||"PRODUCT FILE")}</div><h2 style="font-size:clamp(25px,4vw,38px);line-height:1.1;margin:14px 0">${escapeHTML(p.name)}</h2><div class="hint">基地庫存：${Number(p.stock||0)>0?`可補給 ${Number(p.stock)} 件`:"庫存資訊請洽基地"}</div><div class="detail-price">${money(p.price)}</div><p style="line-height:1.9;font-size:13px;white-space:pre-wrap">${escapeHTML(p.description||"目前沒有額外商品描述。")}</p><div class="form-actions" style="justify-content:flex-start"><button class="btn btn-blue" id="detailAdd">＋ 加入購物車</button><button class="btn btn-outline" data-close="detailModal">返回目錄</button></div><p class="hint">商品圖片及庫存以賣場實際資料為準。</p></div></div>`;$("detailBody").querySelectorAll("[data-thumb]").forEach(b=>b.addEventListener("click",()=>{state.detailImage=Number(b.dataset.thumb);renderDetail()}));$("detailAdd").addEventListener("click",()=>{addToCart(p.id);closeModal("detailModal")})}
function setAuthTab(tab){document.querySelectorAll("[data-auth-tab]").forEach(b=>b.classList.toggle("active",b.dataset.authTab===tab));["loginForm","registerForm","resetForm"].forEach(id=>$(id).classList.toggle("hidden",id!==({login:"loginForm",register:"registerForm",reset:"resetForm"}[tab])));notice($("authNotice"),"登入後可維護會員資料、保存購物車與查看訂單。")}
document.querySelectorAll("[data-auth-tab]").forEach(b=>b.addEventListener("click",()=>setAuthTab(b.dataset.authTab)));
$("accountBtn").addEventListener("click",()=>{openModal("accountModal");if(state.user)showMemberPanel();else showAuthPanel()});$("heroAccount").addEventListener("click",()=>{$("accountBtn").click()});
function showAuthPanel(){$("authPanel").classList.remove("hidden");$("memberPanel").classList.add("hidden");setAuthTab("login")}
function showMemberPanel(){$("authPanel").classList.add("hidden");$("memberPanel").classList.remove("hidden");document.querySelectorAll("[data-member-tab]").forEach(b=>b.classList.toggle("active",b.dataset.memberTab==="profile"));$("profileForm").classList.remove("hidden");$("ordersPanel").classList.add("hidden");loadProfile()}
document.querySelectorAll("[data-member-tab]").forEach(b=>b.addEventListener("click",()=>{const t=b.dataset.memberTab;document.querySelectorAll("[data-member-tab]").forEach(x=>x.classList.toggle("active",x===b));$("profileForm").classList.toggle("hidden",t!=="profile");$("ordersPanel").classList.toggle("hidden",t!=="orders");if(t==="orders")loadOrders()}));
$("loginForm").addEventListener("submit",async e=>{e.preventDefault();try{requireFirebase();await signInWithEmailAndPassword(state.auth,$("loginEmail").value.trim(),$("loginPassword").value);notice($("authNotice"),"登入成功。","success");showMemberPanel()}catch(err){notice($("authNotice"),authError(err),"error")}});
$("registerForm").addEventListener("submit",async e=>{e.preventDefault();if($("regPassword").value!==$("regPassword2").value){notice($("authNotice"),"兩次輸入的密碼不一致。","error");return}try{requireFirebase();const cred=await createUserWithEmailAndPassword(state.auth,$("regEmail").value.trim(),$("regPassword").value);const name=$("regName").value.trim();await updateProfile(cred.user,{displayName:name});await setDoc(doc(state.db,"users",cred.user.uid),{email:cred.user.email,displayName:name,phone:$("regPhone").value.trim(),address:"",createdAt:serverTimestamp(),updatedAt:serverTimestamp()});notice($("authNotice"),"會員帳號建立成功！","success");showMemberPanel()}catch(err){notice($("authNotice"),authError(err),"error")}});
$("resetForm").addEventListener("submit",async e=>{e.preventDefault();try{requireFirebase();await sendPasswordResetEmail(state.auth,$("resetEmail").value.trim());notice($("authNotice"),"若此信箱已註冊，系統將寄送密碼重設信。","success")}catch(err){notice($("authNotice"),authError(err),"error")}});
async function loadProfile(){if(!state.user)return;$("profileEmail").value=state.user.email\vert{}\vert{}"";$("profileName").value=state.user.displayName||"";$("profilePhone").value="";$("profileAddress").value="";try{const snap=await getDoc(doc(state.db,"users",state.user.uid));if(snap.exists()){const d=snap.data();$("profileName").value=d.displayName||state.user.displayName||"";$("profilePhone").value=d.phone\vert{}\vert{}"";$("profileAddress").value=d.address||""}}catch(e){console.warn(e)}}
$("profileForm").addEventListener("submit",async e=>{e.preventDefault();try{requireFirebase();const data={displayName:$("profileName").value.trim(),phone:$("profilePhone").value.trim(),address:$("profileAddress").value.trim(),email:state.user.email,updatedAt:serverTimestamp()};await setDoc(doc(state.db,"users",state.user.uid),data,{merge:true});await updateProfile(state.user,{displayName:data.displayName});$("userChip").textContent=data.displayName;toast("會員資料已儲存。")}catch(err){toast(authError(err))}});
$("logoutBtn").addEventListener("click",async()=>{try{await signOut(state.auth);closeModal("accountModal");toast("已安全登出。")}catch(e){toast(authError(e))}});
async function loadOrders(){if(!state.user)return;const box=$("ordersPanel");box.innerHTML='<div class="hint">正在讀取訂單…</div>';try{const q=query(collection(state.db,"orders"),where("userId","==",state.user.uid));const snap=await getDocs(q);const arr=snap.docs.map(d=>({id:d.id,...d.data()})).sort((a,b)=>(b.createdAt?.seconds||0)-(a.createdAt?.seconds||0));box.innerHTML=arr.length?arr.map(o=>`<div class="notice"><strong>訂單 ${escapeHTML(o.id.slice(-8).toUpperCase())}</strong><br>建立時間：${o.createdAt?.toDate?o.createdAt.toDate().toLocaleString("zh-TW"):"處理中"}<br>金額：${money(o.total)} ｜ 狀態：${escapeHTML(o.status||"pending")}</div>`).join(""):'<div class="empty">目前尚無訂單。</div>'}catch(e){box.innerHTML='<div class="notice error">無法讀取訂單，請確認 Firestore Rules。</div>'}}
$("checkoutBtn").addEventListener("click",async()=>{try{requireFirebase();if(!state.user){notice($("cartNotice"),"請先登入會員，再建立訂單。","error");closeModal("cartModal");openModal("accountModal");showAuthPanel();return}if(!state.cart.length)throw new Error("購物車是空的。");const name=$("checkoutName").value.trim(),phone=$("checkoutPhone").value.trim(),address=$("checkoutAddress").value.trim();if(!name||!phone||!address)throw new Error("請完整填寫收件人、電話與地址。");const items=[];let total=0;for(const row of state.cart){const p=state.products.find(x=>x.id===row.id);if(!p)throw new Error("商品資料已更新，請重新整理購物車。");if(Number(p.stock)<row.qty)throw new Error(`「${p.name}」庫存不足，請調整數量。`);items.push({productId:p.id,name:p.name,sku:p.sku||"",unitPrice:Number(p.price),quantity:row.qty,image:imageFor(p)});total+=Number(p.price)*row.qty}const order=await addDoc(collection(state.db,"orders"),{userId:state.user.uid,email:state.user.email,recipient:name,phone,address,items,total,currency:"TWD",status:"pending_payment",paymentProvider:CHECKOUT_ENDPOINT?"stripe":"not_configured",createdAt:serverTimestamp()});if(!CHECKOUT_ENDPOINT){notice($("cartNotice"),`訂單已建立（${order.id}），但尚未設定真實付款端點。請勿將此狀態視為已付款。`,"error");toast("訂單已建立；付款尚未設定。");return}const response=await fetch(CHECKOUT_ENDPOINT,{method:"POST",headers:{"Content-Type":"application/json","Authorization":"Bearer "+await state.user.getIdToken()},body:JSON.stringify({orderId:order.id})});if(!response.ok)throw new Error("付款服務暫時無法使用，訂單編號："+order.id);const result=await response.json();if(!result.checkoutUrl)throw new Error("付款服務未回傳 checkoutUrl。");location.href=result.checkoutUrl}catch(err){notice($("cartNotice"),err.message||authError(err),"error")}});
/* Admin */
function setAdminTab(tab){document.querySelectorAll("[data-admin-tab]").forEach(b=>b.classList.toggle("active",b.dataset.adminTab===tab));$("productForm").classList.toggle("hidden",tab!=="edit");$("adminProducts").classList.toggle("hidden",tab!=="list");if(tab==="list")renderAdminProducts()}
document.querySelectorAll("[data-admin-tab]").forEach(b=>b.addEventListener("click",()=>setAdminTab(b.dataset.adminTab)));
function resetProductForm(){ $("productForm").reset();$("editProductId").value="";$("pActive").checked=true;$("imagePreview").innerHTML="";state.oldImages=[];state.selectedFiles=[];$("saveProductBtn").textContent="儲存商品資料"}
$("resetProductForm").addEventListener("click",resetProductForm);
$("pImages").addEventListener("change",()=>{state.selectedFiles=[...$("pImages").files];$("imagePreview").innerHTML=[...state.oldImages.map(u=>`<span class="file-chip">既有圖片保留</span>`),...state.selectedFiles.map(f=>`<span class="file-chip">${escapeHTML(f.name)}</span>`)].join("")});
$("productForm").addEventListener("submit",async e=>{e.preventDefault();if(!state.isAdmin){toast("此帳號沒有管理員權限。");return}const btn=$("saveProductBtn");btn.disabled=true;btn.innerHTML='<span class="spinner"></span> 正在儲存';try{const id=$("editProductId").value;let images=[...state.oldImages];for(const file of state.selectedFiles){if(!file.type.startsWith("image/"))throw new Error("請只上傳圖片檔案。");if(file.size>8*1024*1024)throw new Error("單張圖片請小於 8 MB。");const safe=file.name.replace(/[^a-zA-Z0-9._-]/g,"_");const path=`products/${state.user.uid}/${Date.now()}_${crypto.randomUUID()}_${safe}`;const storageRef=ref(state.storage,path);await uploadBytes(storageRef,file,{contentType:file.type});images.push(await getDownloadURL(storageRef))}const data={name:$("pName").value.trim(),sku:$("pSku").value.trim(),category:$("pCategory").value,price:Number($("pPrice").value),stock:Number($("pStock").value),description:$("pDescription").value.trim(),images,active:$("pActive").checked,updatedAt:serverTimestamp(),updatedBy:state.user.uid};if(!data.name||!Number.isFinite(data.price)||data.price<0||!Number.isInteger(data.stock)||data.stock<0)throw new Error("請確認商品名稱、價格與庫存格式。");if(id)await updateDoc(doc(state.db,"products",id),data);else await addDoc(collection(state.db,"products"),{...data,createdAt:serverTimestamp(),createdBy:state.user.uid});toast(id?"商品已更新。":"商品已建立。");resetProductForm();await loadProducts();setAdminTab("list")}catch(err){toast(err.message||authError(err))}finally{btn.disabled=false;btn.textContent="儲存商品資料"}});
function renderAdminProducts(){$("adminProducts").innerHTML=state.products.length?state.products.map(p=>`<div class="admin-item"><img src="${escapeHTML(imageFor(p))}" alt=""><div><h4>${escapeHTML(p.name)}</h4><p>${money(p.price)} / 庫存 ${Number(p.stock||0)} / ${p.active===false?"未上架":"上架中"}</p></div><div class="admin-actions" style="display:flex;gap:6px;flex-wrap:wrap"><button class="btn btn-outline" style="padding:8px" data-edit="${escapeHTML(p.id)}">編輯</button><button class="btn btn-red" style="padding:8px" data-delete="${escapeHTML(p.id)}">刪除</button></div></div>`).join(""):'<div class="empty">尚無商品資料。</div>'}
document.addEventListener("click",async e=>{const edit=e.target.closest("[data-edit]");if(edit){const p=state.products.find(x=>x.id===edit.dataset.edit);if(!p)return;setAdminTab("edit");$("editProductId").value=p.id;$("pName").value=p.name\vert{}\vert{}"";$("pSku").value=p.sku||"";$("pCategory").value=p.category\vert{}\vert{}"鋼彈模型";$("pPrice").value=p.price??0;$("pStock").value=p.stock??0;$("pDescription").value=p.description||"";$("pActive").checked=p.active!==false;state.oldImages=[...(p.images\vert{}\vert{}[])];state.selectedFiles=[];$("pImages").value="";$("imagePreview").innerHTML=state.oldImages.map(()=>'<span class="file-chip">既有圖片保留</span>').join("");$("saveProductBtn").textContent="更新商品資料";return}const del=e.target.closest("[data-delete]");if(del&&state.isAdmin){const p=state.products.find(x=>x.id===del.dataset.delete);if(!p||!confirm(`確定刪除「${p.name}」？此操作無法復原。`))return;try{await deleteDoc(doc(state.db,"products",p.id));await loadProducts();renderAdminProducts();toast("商品已刪除。")}catch(err){toast(authError(err))}}});
function updateAccountUI(){const logged=!!state.user;$("userChip").textContent=logged?(state.user.displayName||state.user.email):"";$("accountBtn").title=logged?"會員中心":"會員登入";if(state.isAdmin){$("adminAccess")?.remove();const b=document.createElement("button");b.id="adminAccess";b.className="btn btn-red";b.textContent="基地管理";b.addEventListener("click",()=>{openModal("adminModal");resetProductForm();setAdminTab("edit")});document.querySelector(".nav-actions").insertBefore(b,$("cartBtn"))}else $("adminAccess")?.remove()}
async function loadProducts(){try{requireFirebase();const snap=await getDocs(collection(state.db,"products"));state.products=snap.docs.map(d=>({id:d.id,...d.data()}));$("connectionStatus").textContent="DATABASE: ONLINE";renderProducts();renderCartCount()}catch(e){$("connectionStatus").textContent="DATABASE: OFFLINE / CONFIG REQUIRED";$("productGrid").innerHTML=`<div class="empty">無法連線至 Firebase 商品資料庫。<br><br>請確認 Firestore 已啟用且 Rules 符合規範。<br><small>${escapeHTML(e.message||"")}</small></div>`}}
function initFirebase(){
  try{
    state.app=initializeApp(firebaseConfig);
    state.auth=getAuth(state.app);
    state.db=getFirestore(state.app);
    state.storage=getStorage(state.app);
    onAuthStateChanged(state.auth,async user=>{
      state.user=user;
      state.isAdmin=!!user&&ADMIN_EMAILS.map(x=>x.toLowerCase()).includes((user.email||"").toLowerCase());
      updateAccountUI();
      if(user){
        try{
          const s=await getDoc(doc(state.db,"users",user.uid));
          if(!s.exists())await setDoc(doc(state.db,"users",user.uid),{email:user.email,displayName:user.displayName||"",phone:"",address:"",createdAt:serverTimestamp()},{merge:true})
        }catch(e){console.warn(e)}
      }
      await loadProducts()
    })
  }catch(e){
    $("connectionStatus").textContent="DATABASE: INIT ERROR";
    $("productGrid").innerHTML=`<div class="empty">Firebase 初始化失敗：${escapeHTML(e.message)}</div>`
  }
}
renderCartCount();initFirebase();
</script>
</body></html>
